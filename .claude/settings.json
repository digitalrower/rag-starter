{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(docker push *)",
      "Bash(docker login *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "files": [
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" }
      ]
    },
    "filesystem": {
      "denyRead": ["~/.aws/credentials", "~/.ssh/**"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "pypi.org",
        "*.pythonhosted.org",
        "api.anthropic.com",
        "cloud.langfuse.com",
        "us.cloud.langfuse.com",
        "huggingface.co",
        "*.huggingface.co",
        "chroma-onnx-models.s3.amazonaws.com"
      ]
    }
  }
}
