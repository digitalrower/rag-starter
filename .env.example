# Copy this file to .env and fill in your actual values
# Get your Anthropic API key at console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Langfuse tracing and eval experiments
# Get your keys from Project Settings in the Langfuse UI
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
# Region host: https://us.cloud.langfuse.com (US), https://cloud.langfuse.com (EU)
LLANGFUSE_BASE_URL=https://us.cloud.langfuse.com