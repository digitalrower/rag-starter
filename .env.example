# Copy this file to .env and fill in your actual values
# Get your Anthropic API key at console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Langfuse tracing and eval experiments. Optional: without these the pipeline
# still answers, but records no traces and eval runs produce no scores.
# Get your keys from Project Settings in the Langfuse UI
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
# Region host: https://us.cloud.langfuse.com (US), https://cloud.langfuse.com (EU)
# Must match the region your keys belong to; the default is the EU host.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com